SECRET_KEY=
# Obscure admin panel URL — use a random string, e.g. "xk9p2m8q3r/" (include trailing slash)
ADMIN_URL=admin/
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
DEBUG=
ALLOWED_HOSTS=
DJANGO_SETTINGS_MODULE=

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email
# EMAIL_BACKEND is not set here — settings.py auto-selects:
#   venv (DEBUG=True): console backend, emails print to the terminal
#   Docker: docker-compose.yml overrides to smtp, emails go to MailHog at localhost:8025
#   production (DEBUG=False): Anymail's Resend backend — set RESEND_API_KEY below
# EMAIL_BACKEND=

# The EMAIL_* settings below apply to the SMTP backend only. The Resend backend
# used in production talks to an HTTP API and ignores all of them except
# DEFAULT_FROM_EMAIL.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=studyflow@example.com

# Required in production — without it the Resend backend fails to send.
# Create one at https://resend.com → API Keys
RESEND_API_KEY=

# Where new feature suggestions are emailed. Leave blank to disable.
FEATURE_REQUEST_NOTIFY_EMAIL=

# Set to "none" to disable email verification (e.g. while SMTP is blocked)
# Set to "mandatory" for production once SMTP is working
ACCOUNT_EMAIL_VERIFICATION=mandatory

# YouTube Data API v3 key — required for YouTube playlist/video import
# Get one at https://console.cloud.google.com → Enable "YouTube Data API v3" → Create API key
YOUTUBE_API_KEY=

# Logging — defaults to DEBUG when DEBUG=True, INFO otherwise
# LOG_LEVEL=INFO
# DJANGO_LOG_LEVEL=INFO